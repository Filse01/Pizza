@{
    ViewData["Title"] = "Order Successful";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="card bg-dark-card border-0 shadow-lg p-5">
                
                <div class="mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="#198754" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                    </svg>
                </div>

                <h2 class="text-white mb-3">Order Placed Successfully!</h2>
                <p class="text-muted fs-5 mb-4">
                    Thank you for your order. We've received it and are preparing your delicious pizza right now!
                </p>

                <hr class="my-4 border-secondary">

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4 gap-3">Back to Menu</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Dark Theme Styles */
    body {
        background-color: #121212; 
        color: #e0e0e0;
    }
    .bg-dark-card {
        background-color: #1e1e1e;
    }
</style>