@using AddOrderPageViewModel = Pizza.ViewModels.AddOrderPageViewModel
@model AddOrderPageViewModel

<div class="container py-5">
    <div class="row g-5">
        
        <div class="col-md-5 col-lg-4 order-md-last ">
            <div class="sticky-top pt-1">
                
                <h4 class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-primary">Your Cart</span>
                    <span class="badge bg-primary rounded-pill">@Model.Cart.CartItems.Count()</span>
                </h4>

                <ul class="list-group mb-3 shadow-sm cartItemBox">
                    @foreach (var pizza in Model.Cart.CartItems)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center lh-sm bg-dark-card text-light border-secondary" >
                            <div class="me-2">
                                <h6 class="my-0">@pizza.Pizza.Name</h6>
                                <small class="text-muted">@pizza.Pizza.Description</small>
                            </div>
                            <div class="d-flex align-items-center">
                                <span id="pizzaPrice" class="text-light me-3">@pizza.Pizza.Price</span>
                                <a asp-controller="Cart" asp-action="RemoveFromCart" asp-route-cartItemId="@pizza.Id"
                                   class="btn btn-sm btn-outline-danger border-0" title="Remove">
                                    &#10005;
                                </a>
                            </div>
                        </li>
                    }

                    @if (!string.IsNullOrEmpty(Model.Coupon?.Name))
                    {
                        <li class="list-group-item d-flex justify-content-between bg-dark-card border-secondary">
                            <div class="text-success">
                                <h6 class="my-0">Promo code</h6>
                                <small>@Model.Coupon.Name</small>
                            </div>
                            <span class="text-success">-$5 (Example)</span>
                        </li>
                    }

                    <li class="list-group-item d-flex justify-content-between bg-dark-card border-secondary">
                        <span class="text-light">Total (EUR)</span>
                        <strong  class="text-white fs-5">€<span id="cartPrice">@Model.Cart.Price</span></strong>
                    </li>
                </ul>
            </div>
            
        </div>

        <div class="col-md-7 col-lg-8">
            <div class="card bg-dark-card border-0 shadow-lg p-4">
                <h4 class="mb-4 text-white">Billing Address</h4>
                
                <form id="submit" asp-controller="Cart" asp-action="CreateCheckoutSession" asp-route-amount="@Model.Cart.Price" class="needs-validation" novalidate method="post">
                    
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="form-floating">
                                <input asp-for="Order.FirstName" type="text" class="form-control bg-dark text-light border-secondary" id="firstName" placeholder="First Name" required>
                                <label for="firstName" class="text-muted">First name</label>
                                <span asp-validation-for="Order.FirstName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="form-floating">
                                <input asp-for="Order.LastName" type="text" class="form-control bg-dark text-light border-secondary" id="lastName" placeholder="Last Name" required>
                                <label for="lastName" class="text-muted">Last name</label>
                                <span asp-validation-for="Order.LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-floating">
                                <input asp-for="Order.Address" type="text" class="form-control bg-dark text-light border-secondary" id="address" placeholder="1234 Main St" required>
                                <label for="address" class="text-muted">Address</label>
                                <span asp-validation-for="Order.Address" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-floating">
                                <input asp-for="Order.PhoneNumber" type="number" class="form-control bg-dark text-light border-secondary" id="phone" placeholder="Phone" required>
                                <label for="phone" class="text-muted">Phone Number</label>
                                <span asp-validation-for="Order.PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4 border-secondary">

                    <h4 class="mb-3 text-white">Payment</h4>
                    <div class="my-3">
                        <div class="form-check">
                            <input id="cash" name="paymentMethod" type="radio" class="form-check-input" checked required>
                            <label class="form-check-label text-light" for="cash">Cash on Delivery</label>
                        </div>
                    </div>

                    <hr class="my-4 border-secondary">

                    <div class="mb-4">
                        <label asp-for="Coupon.Name" class="form-label text-muted">Promo Code</label>
                        <div class="input-group">
                            <input id="couponName" asp-for="Coupon.Name" type="text" class="form-control bg-dark text-light border-secondary" placeholder="Enter code here">
                            
                            <a id="buttonCoupon" formnovalidate class="btn btn-secondary">Apply</a>
                        </div>
                    </div>

                    <button class="w-100 btn btn-primary btn-lg" type="submit">Place Order</button>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    let buttonCoupon = document.getElementById('buttonCoupon');
    buttonCoupon.addEventListener('click', applyDiscount)
    async function applyDiscount(){
        let couponName = document.getElementById('couponName');
        const query = new URLSearchParams({ couponName: couponName.value }).toString();
        const finalUrl = `/Cart/ApplyCoupon?${query}`;
        let response = await fetch(finalUrl);
        let percentage = await response.json();
        let cartPrice = document.getElementById('cartPrice');
        let pizzaPrices = document.querySelectorAll('#pizzaPrice');
        pizzaPrices.forEach((pizza) => {
            pizza.textContent = (pizza.textContent * (100 - percentage) / 100).toFixed(2);
        })
        cartPrice.textContent = (cartPrice.textContent * (100 - percentage) / 100).toFixed(2);

        if (response.status === 200) {
            buttonCoupon.removeEventListener('click', applyDiscount)
        }
    }
</script>

<style>
    /* Dark Theme Styles */
    body {
        background-color: #121212; 
        color: #e0e0e0;
    }
    .bg-dark-card {
        background-color: #1e1e1e;
    }
    .form-floating > label {
        color: #adb5bd;
    }
    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: rgba(255, 255, 255, 0.65);
    }
    .form-control:focus {
        background-color: #121212;
        color: white;
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }
    /* Autofill fix */
    input:-webkit-autofill,
    input:-webkit-autofill:hover, 
    input:-webkit-autofill:focus, 
    input:-webkit-autofill:active{
        -webkit-box-shadow: 0 0 0 30px #121212 inset !important;
        -webkit-text-fill-color: white !important;
    }
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        /* display: none; <- Crashes Chrome on hover */
        -webkit-appearance: none;
        margin: 0; /* <-- Apparently some margin are still there even though it's hidden */
    }

    input[type=number] {
        -moz-appearance:textfield; /* Firefox */
    }
</style>
